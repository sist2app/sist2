# Copy to demo/.env on the host that runs the demo. Not in git: ES_URL carries a password.

# Released image to deploy
SIST2_IMAGE=sist2app/sist2:4.0.5-x64-linux

# Corpus root: holds one folder per index (see `corpora` in update_demo.sh)
DATA_DIR=/dockerdata/sist2-data
# Where the .sist2 files are written. Deleted and rebuilt on every run
INDEX_DIR=/dockerdata/sist2-demo-index

# Elasticsearch, as reachable from DOCKER_NETWORK
ES_URL=http://elastic:password@elasticsearch:9200
ES_INDEX=sist2

# Existing network of the traefik and elasticsearch containers
DOCKER_NETWORK=compose_default
DEMO_HOST=sist2-demo.vampi.red

# Optional
#TAGLINE=Lightning-fast file system indexer and search tool
#THREADS=4
