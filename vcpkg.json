{
  "name": "sist2",
  "version-string": "4.0.0",
  "builtin-baseline": "ce613c41372b23b1f51333815feb3edd87ef8a8b",
  "vcpkg-configuration": {
    "overlay-ports": ["./overlay-ports"]
  },
  "dependencies": [
    "openblas",
    "antiword",
    "libmobi",
    "libwpd",
    "utf8h",
    {
      "name": "curl",
      "default-features": false,
      "features": ["openssl"]
    },
    {
      "name": "sqlite3",
      "default-features": false,
      "features": ["fts5", "json1"]
    },
    "cpp-jwt",
    "pcre",
    "cjson",
    "brotli",
    {
      "name": "libarchive",
      "default-features": false,
      "features": ["bzip2", "libxml2", "lz4", "lzma", "lzo"]
    },
    "pthread",
    "tesseract",
    "libxml2",
    {
      "name": "libmupdf",
      "features": ["ocr"]
    },
    "mongoose",
    "libmagic",
    "libraw",
    "gumbo",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec", "avformat", "swscale", "swresample", "webp", "opus", "mp3lame", "vpx", "zlib"]
    },
    {
      "name": "libgit2",
      "default-features": false,
      "features": ["pcre"]
    }
  ],
  "features": {
    "tests": {
      "description": "Build libscan tests",
      "dependencies": ["gtest"]
    }
  }
}
